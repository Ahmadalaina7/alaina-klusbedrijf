# Canonical origin. https://alainabouw.nl is the default; www redirects there.
NEXT_PUBLIC_SITE_URL=https://alainabouw.nl

# Optional. Code from Google Search Console → HTML tag, only the content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Publish only contact information confirmed by the business owner.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_POSTAL_CODE=
NEXT_PUBLIC_ADDRESS_LOCALITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_KVK=
# Example: Rotterdam en omgeving
NEXT_PUBLIC_SERVICE_AREA=
# Schema.org compact form only, for example: Mo-Fr 08:00-17:00
NEXT_PUBLIC_OPENING_HOURS=
# Comma-separated https profile URLs, for example an Instagram or Google Business profile.
NEXT_PUBLIC_SAME_AS=

# Required for accepted quote requests. HTTPS only except local development.
# The receiving system must securely handle the uploaded image and personal data.
LEAD_WEBHOOK_URL=
